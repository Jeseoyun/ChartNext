# HDFS 설정
HDFS_HOST=localhost
HDFS_PORT=9870
HDFS_USER=hdfs
HDFS_URL=http://localhost:9870

# 크롤링 설정
INITIAL_ARTICLES_PER_CATEGORY=10000  # 초기 크롤링 시 카테고리당 기사 수
STREAMING_ARTICLES_PER_CATEGORY=10    # 실시간 크롤링 시 카테고리당 기사 수
STREAMING_INTERVAL=300                # 실시간 크롤링 간격 (초)

# 저장 경로 설정
HDFS_BASE_PATH=/news_data
HDFS_RAW_PATH=/news_data/raw        # 초기 데이터 저장 경로
HDFS_STREAM_PATH=/news_data/stream  # 스트리밍 데이터 저장 경로

# Spark 설정
SPARK_MASTER_URL=spark://localhost:7077